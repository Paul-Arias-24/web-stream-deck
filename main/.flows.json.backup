    },
    {
        "id": "c247d040f29efa10",
        "type": "function",
        "z": "4004cd493f1e2a8f",
        "name": "function 4",
        "func": "\nif(msg.payload == \"ConectionOpened\" || msg.payload == \"Identified\" ){\n    msg = {payload : true, topic : \"Intento 1\"};\n}else {\n    msg = {payload : false, topic : \"Intento 1\"};\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
