    {
        "id": "9e2979110eb4ad48",
        "type": "function",
        "z": "4004cd493f1e2a8f",
        "name": "function 3",
        "func": "let host = flow.get(\"ip\") || \"127.0.0.1\";\nlet puerto = flow.get(\"puerto\") || \"4455\";\n\n\nlet cfg = msg.payload.find(n => n.id === \"aadb6d9203250703\");\ncfg.host = host;\ncfg.port = puerto;\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\",\n    \"Node-RED-Deployment-Type\": \"nodes\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 260,
        "wires": [
