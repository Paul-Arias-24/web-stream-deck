        "width": "1",
        "height": "1",
        "head": "",
        "format": "<template>\n    <div\n    class=\"indicador_cam\"\n    :style= \"{ backgroundColor: msg?.payload === true ? 'green' : 'red' }\">\n     {{ msg?.payload === true ? '' : '' }}   \n    </div>\n</template>\n\n<style>\n.indicador_cam {\n  padding: 16px;\n  border-radius: 8px;\n  color: white;\n  text-align: center;\n  font-weight: bold;\n}\n</style>",
        "noerr": 0,
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
