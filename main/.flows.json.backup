    {
        "id": "315cfd13270c5e87",
        "type": "function",
        "z": "069f8fd68979ffa4",
        "name": "function 1",
        "func": "let e1 = flow.get(\"e1\");\nlet e2 = flow.get(\"e2\");\nlet e3 = flow.get(\"e3\");\nlet e4 = flow.get(\"e4\");\nlet e5 = flow.get(\"e5\");\nlet e6 = flow.get(\"e6\");\nswitch(msg.payload){\n    case 1:\n        msg = {payload : e1.payload, topic : \"Intento 1\"};\n        break;\n    case 2:\n        msg = {payload : e2.payload, topic : \"Intento 1\"};\n        break;\n    case 3:\n        msg = { payload: e3.payload, topic: \"Intento 1\" };\n        break;\n    case 4:\n        msg = { payload: e4.payload, topic: \"Intento 1\" };\n        break;\n    case 5:\n        msg = { payload: e5.payload, topic: \"Intento 1\" };\n        break;\n    case 6:\n        msg = { payload: e6.payload, topic: \"Intento 1\" };\n        break;\n    default:\n        msg = { payload: e1.payload, topic: \"Intento 1\" };\n        break;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
